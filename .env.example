# Copy to .env.local and fill in real values.
# Create a Vercel Postgres store and pull env, or paste POSTGRES_URL manually.

POSTGRES_URL=

# Auth.js / NextAuth
AUTH_SECRET=
# Optional on Vercel; set locally e.g. http://localhost:3000
AUTH_URL=http://localhost:3000

# Single admin credentials (password hash from: node -e "require('bcryptjs').hash('your-password',10).then(console.log)")
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=123
