# Copy to .env.local and fill in real values.

# SQLite database file (relative to project root, or absolute path)
DATABASE_URL=file:./data/portfolio.db

# Auth.js / NextAuth
AUTH_SECRET=
# Optional on Vercel; set locally e.g. http://localhost:3000
AUTH_URL=http://localhost:3000

# Single admin credentials (password hash from: node -e "require('bcryptjs').hash('your-password',10).then(h => console.log(h.replaceAll('$', '\\$')))")
# IMPORTANT: escape every $ as \$ — Next.js expands $VAR and corrupts bcrypt hashes
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=\$2b\$10\$abkcPd.1yGf2lkoIkba2gOS/bex1dKfU3OcKtNHyzhP.eC.ACAgnK

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Local: leave ENABLED=false (captcha skipped). Production: set ENABLED=true + keys.
NEXT_PUBLIC_RECAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics 4 — https://analytics.google.com/
# Measurement ID looks like G-XXXXXXXXXX. Skipped automatically in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
